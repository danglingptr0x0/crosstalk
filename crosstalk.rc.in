1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/img/crosstalk.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Crosstalk"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "crosstalk"
            VALUE "LegalCopyright", "Copyright 2026 Ongakken Corporation OU"
            VALUE "OriginalFilename", "crosstalk.exe"
            VALUE "ProductName", "Crosstalk"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
